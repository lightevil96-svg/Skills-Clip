{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skills-Clip Edit Plan",
  "type": "object",
  "required": ["project", "source", "routing", "clip", "shots", "captions", "audio", "qa"],
  "properties": {
    "project": {"type": "object", "required": ["title", "target_platforms", "language"], "properties": {
      "title": {"type": "string"}, "target_platforms": {"type": "array", "items": {"enum": ["youtube-shorts", "tiktok", "instagram-reels"]}},
      "language": {"type": "string"}, "notes": {"type": "string"}
    }},
    "source": {"type": "object", "required": ["path", "duration_s", "width", "height", "fps", "audio_present"], "properties": {
      "path": {"type": "string"}, "duration_s": {"type": "number", "exclusiveMinimum": 0},
      "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
      "fps": {"type": "number", "exclusiveMinimum": 0}, "audio_present": {"type": "boolean"},
      "ffmpeg_version": {"type": ["string", "null"]}
    }},
    "routing": {"type": "object", "required": ["primary_route", "footage_type", "visual_evidence", "unknowns"], "properties": {
      "primary_route": {"type": "string"}, "supporting_routes": {"type": "array", "items": {"type": "string"}},
      "footage_type": {"type": "string"}, "speakers_visible": {"type": ["integer", "null"], "minimum": 0},
      "speakers_verified": {"type": "boolean"}, "visual_evidence": {"type": "array", "items": {"type": "string"}},
      "unknowns": {"type": "array", "items": {"type": "string"}}
    }},
    "clip": {"type": "object", "required": ["in_s", "out_s", "hook", "payoff"], "properties": {
      "in_s": {"type": "number", "minimum": 0}, "out_s": {"type": "number", "exclusiveMinimum": 0},
      "hook": {"type": "string"}, "payoff": {"type": "string"}, "context_preserved": {"type": "boolean"},
      "candidate_score_0_12": {"type": ["integer", "null"], "minimum": 0, "maximum": 12}
    }},
    "speakers": {"type": "array", "items": {"type": "object", "required": ["speaker_id", "mapping_status"], "properties": {
      "speaker_id": {"type": "string"}, "display_name": {"type": ["string", "null"]},
      "avatar_ref": {"type": ["string", "null"]}, "mapping_status": {"enum": ["UNKNOWN", "CANDIDATE", "VERIFIED", "USER_CONFIRMED"]}
    }}},
    "shots": {"type": "array", "items": {"type": "object", "required": ["id", "in_s", "out_s", "layout", "reason"], "properties": {
      "id": {"type": "string"}, "in_s": {"type": "number", "minimum": 0}, "out_s": {"type": "number", "exclusiveMinimum": 0},
      "layout": {"enum": ["full-bleed", "subject-crop", "blur-fit", "stacked", "side-by-side", "avatar-inset", "speaker-follow", "shared-two-shot"]},
      "crop": {"type": ["object", "null"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "w": {"type": "number"}, "h": {"type": "number"}}},
      "primary_subject": {"type": ["string", "null"]}, "reason": {"type": "string"},
      "caption_ids": {"type": "array", "items": {"type": "string"}}, "overlay_ids": {"type": "array", "items": {"type": "string"}}
    }}},
    "captions": {"type": "array", "items": {"type": "object", "required": ["id", "start_s", "end_s", "text", "speaker_id", "verification_status"], "properties": {
      "id": {"type": "string"}, "start_s": {"type": "number", "minimum": 0}, "end_s": {"type": "number", "exclusiveMinimum": 0},
      "text": {"type": "string"}, "speaker_id": {"type": ["string", "null"]},
      "verification_status": {"enum": ["ASR_RAW", "VERIFIED", "USER_CONFIRMED", "UNKNOWN"]}, "style": {"type": ["string", "null"]}
    }}},
    "audio": {"type": "object", "required": ["voice_priority", "bgm_used", "sfx_used", "human_listen_required"], "properties": {
      "voice_priority": {"type": "boolean"}, "bgm_used": {"type": "boolean"}, "sfx_used": {"type": "boolean"},
      "ducking_db": {"type": ["number", "null"]}, "target_lufs": {"type": ["number", "null"]},
      "true_peak_db": {"type": ["number", "null"]}, "human_listen_required": {"type": "boolean"}
    }},
    "assets": {"type": "array", "items": {"type": "object", "properties": {"path": {"type": "string"}, "source": {"type": "string"}, "license": {"type": "string"}}}},
    "qa": {"type": "object", "required": ["status", "checks"], "properties": {
      "status": {"enum": ["PASS", "FAIL", "REVIEW", "NOT_RUN"]},
      "checks": {"type": "array", "items": {"type": "object", "required": ["name", "status"], "properties": {
        "name": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "REVIEW", "SKIP", "NOT_RUN"]}, "detail": {"type": "string"}
      }}}
    }}
  }
}
