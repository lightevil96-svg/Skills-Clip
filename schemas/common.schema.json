{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-clip.example/schemas/common.schema.json",
  "$defs": {
    "verification": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "human-listen",
            "direct-audio-review",
            "user-confirmation"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_in_s": {
          "type": "number",
          "minimum": 0
        },
        "source_out_s": {
          "type": "number",
          "minimum": 0
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "context_checked": {
          "type": "boolean"
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "method",
        "reviewer",
        "tool",
        "reviewed_at",
        "source_ref",
        "source_in_s",
        "source_out_s",
        "language",
        "context_checked",
        "uncertainties",
        "evidence_ref"
      ],
      "additionalProperties": false
    },
    "crop": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "in_s": {
          "type": "number",
          "minimum": 0
        },
        "out_s": {
          "type": "number",
          "minimum": 0
        },
        "method": {
          "enum": [
            "visual-inspection",
            "audio-review",
            "user-confirmation",
            "asr",
            "metadata"
          ]
        },
        "status": {
          "enum": [
            "VERIFIED",
            "USER_CONFIRMED",
            "ASR_RAW",
            "CANDIDATE",
            "UNKNOWN"
          ]
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "id",
        "source_ref",
        "in_s",
        "out_s",
        "method",
        "status",
        "observation",
        "artifact_ref",
        "confidence"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "REVIEW",
        "SKIP",
        "NOT_RUN"
      ]
    }
  }
}
